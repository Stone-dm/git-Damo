# ===== Party School 环境变量 =====
#
# Docker 使用步骤：
#   cp .env.example .env   （从 Web/ 目录）
#   cp Web/.env.example .env  （从项目根目录）
#   编辑 .env 填写 DEEPSEEK_API_KEY 后执行 docker compose up -d
# ===================================

# MySQL — Docker Compose 默认映射到宿主机 3307（避开本机 3306）
# 容器内访问使用：MYSQL_HOST=mysql, MYSQL_PORT=3306
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=party_school
MYSQL_USER=party
MYSQL_PASSWORD=party123

# Milvus — 本机已有 Milvus 时保持 localhost:19530，不要加 --profile milvus
# 使用 Docker 内 Milvus 时改为：MILVUS_HOST=milvus, MILVUS_PORT=19530
MILVUS_HOST=localhost
MILVUS_PORT=19530

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

JWT_SECRET=change-me-to-a-long-random-string
AGENT_BASE_URL=http://agent:8000
# Optional shared secret for Backend → Agent (X-Agent-Token). Empty = open agent (dev).
AGENT_SHARED_TOKEN=
BACKEND_BASE_URL=http://backend:8080

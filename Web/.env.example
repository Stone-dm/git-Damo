# ===== Party School 环境变量 =====
#
# Docker 使用：
#   cp .env.example .env          # 在 Web/ 下
#   或：cp Web/.env.example .env  # 在项目根目录
#   编辑 .env 后：docker compose up -d --build
# ===================================

# MySQL — 宿主机映射 3307（避开本机 3306）
# 容器内后端访问使用：MYSQL_HOST=mysql, MYSQL_PORT=3306（compose 已写死）
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=party_school
MYSQL_USER=party
MYSQL_PASSWORD=party123

# Milvus
# - 默认：Agent 容器通过 host.docker.internal 连宿主机已有的 19530
# - 使用 compose 自带向量栈时：docker compose --profile milvus up -d
#   并把下面改成 MILVUS_HOST=milvus
MILVUS_HOST=host.docker.internal
MILVUS_PORT=19530

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

JWT_SECRET=change-me-to-a-long-random-string
AGENT_BASE_URL=http://agent:8000
# Optional shared secret for Backend → Agent (X-Agent-Token). Empty = open agent (dev).
AGENT_SHARED_TOKEN=
BACKEND_BASE_URL=http://backend:8080
